<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#EEF3FF" /><stroke android:width="4dp" android:color="#1E5BD8" /><corners android:radius="16dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#DCE6FB" /><stroke android:width="2dp" android:color="#1E5BD8" /><corners android:radius="16dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#FFFFFF" /><stroke android:width="2dp" android:color="#DFE4EE" /><corners android:radius="16dp" /></shape>
    </item>
</selector>
