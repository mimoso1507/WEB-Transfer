<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#0B3FA8" /><stroke android:width="4dp" android:color="#FFC400" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#0B3FA8" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#1E5BD8" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
